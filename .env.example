TAVILY_API_KEY=
AI_DISCORD_TOKEN=
ORBIT_API_TOKEN=
ORBIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ORBIT_DB_DIR=
SPIDEY_ALLOW_HUB=
# Set SPIDEY_ALLOW_HUB=1 once to download Phonon weights; then offline startup is safe.
TTS_BACKEND=phonon
PHONON_MODEL=hf://gradium/phonon-31m-en
PHONON_QUANT=q8
PHONON_LANG=en
SPIDEY_TTS_VOICE=Easton
SPIDEY_EAGER_EMBEDDER=0

# Ollama LLM Engine Configuration
# Recommended for 6 GB GPU shared with Ollama: set OLLAMA_MAX_LOADED_MODELS=1 in the system environment.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT=120

# Agent Tool Calling Configuration
ORBIT_TOOLS=1
ORBIT_TOOL_MODE=native
