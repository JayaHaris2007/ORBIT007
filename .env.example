# Discord bot integration (backend only; never expose these in React/Vite).
AI_DISCORD_TOKEN=
AI_DISCORD_PREFIX=!

# Optional comma-separated Discord IDs. Empty means no allowlist restriction.
AI_DISCORD_ALLOWED_USER_IDS=
AI_DISCORD_ALLOWED_GUILD_IDS=

# Keep CPU mode explicit when CUDA is unavailable.
AI_ALLOW_CPU_LLM=0
