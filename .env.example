TAVILY_API_KEY=
AI_DISCORD_TOKEN=
ORBIT_API_TOKEN=
ORBIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ORBIT_DB_DIR=
SPIDEY_ALLOW_HUB=
TTS_INSTRUCT=male, low pitch, young adult, american accent

# Optional Ollama LLM backend configuration (defaults to transformers if unset)
# LLM_BACKEND=transformers          # Inference backend: "transformers" (default) or "ollama"
# OLLAMA_URL=http://127.0.0.1:11434 # Ollama server HTTP base URL
# OLLAMA_MODEL=qwen3.5:4b           # Ollama model tag to use
# OLLAMA_NUM_CTX=4096              # Context window size in tokens
# OLLAMA_KEEP_ALIVE=5m             # How long to keep model loaded in VRAM (e.g. "5m", "-1")
# OLLAMA_TIMEOUT=120               # Request timeout in seconds
